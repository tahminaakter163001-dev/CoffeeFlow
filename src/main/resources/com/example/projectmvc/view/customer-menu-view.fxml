<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.CustomerMenuController"
            minWidth="900.0"
            minHeight="600.0"
            prefWidth="1000.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              prefHeight="80.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="0.0"
                        right="35.0"
                        bottom="0.0"
                        left="35.0"/>
            </padding>

            <Label text="☕ CoffeeFlow"
                   textFill="WHITE">
                <font>
                    <Font name="System Bold"
                          size="24.0"/>
                </font>
            </Label>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="← Back to Home"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

        </HBox>
    </top>


    <!-- Main Content -->
    <center>

        <VBox spacing="15.0"
              alignment="TOP_CENTER">

            <padding>
                <Insets top="30.0"
                        right="35.0"
                        bottom="30.0"
                        left="35.0"/>
            </padding>

            <Label text="Our Coffee Menu"
                   textFill="#4A3428">
                <font>
                    <Font name="System Bold"
                          size="30.0"/>
                </font>
            </Label>

            <Label text="Choose your favorite coffee and make your moment special."
                   textFill="#8C7A6B">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>


            <!-- Coffee Cards -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">

                <content>

                    <FlowPane fx:id="coffeeContainer"
                              alignment="CENTER"
                              hgap="20.0"
                              vgap="20.0">

                        <padding>
                            <Insets top="15.0"
                                    right="10.0"
                                    bottom="15.0"
                                    left="10.0"/>
                        </padding>

                    </FlowPane>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>