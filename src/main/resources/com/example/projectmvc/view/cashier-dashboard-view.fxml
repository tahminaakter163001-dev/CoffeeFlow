<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.projectmvc.controller.CashierDashboardController"
        minWidth="850.0"
        minHeight="550.0"
        prefWidth="1100.0"
        prefHeight="700.0"
        style="-fx-background-color: #F5EFE6;">

    <top>

        <VBox alignment="CENTER_LEFT"
              spacing="3.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="CoffeeFlow - Cashier Dashboard"
                   textFill="WHITE"
                   wrapText="true">

                <font>
                    <Font name="System Bold"
                          size="24.0"/>
                </font>

            </Label>

            <Label text="View customer orders and confirm pending orders."
                   textFill="WHITE"
                   wrapText="true">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>

    </top>

    <center>

        <VBox spacing="15.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>
            </padding>

            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="15.0"
                            right="15.0"
                            bottom="15.0"
                            left="15.0"/>
                </padding>

                <Label text="Customer Orders"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="20.0"/>
                    </font>

                </Label>

                <TableView fx:id="orderTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="Order ID"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="customerColumn"
                                     text="Customer"
                                     prefWidth="130.0"/>

                        <TableColumn fx:id="coffeeColumn"
                                     text="Coffee"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="sizeColumn"
                                     text="Size"
                                     prefWidth="90.0"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="90.0"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Order Date"
                                     prefWidth="170.0"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="120.0"/>

                    </columns>

                </TableView>

            </VBox>

            <HBox spacing="15.0"
                  alignment="CENTER_RIGHT">

                <Button text="Refresh"
                        onAction="#handleRefresh"
                        prefWidth="110.0"
                        prefHeight="40.0"
                        style="-fx-background-color: #E8D8C8;
                               -fx-text-fill: #6F4E37;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <Button fx:id="confirmButton"
                        text="Confirm Order"
                        onAction="#handleConfirmOrder"
                        prefWidth="150.0"
                        prefHeight="40.0"
                        style="-fx-background-color: #6F4E37;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

            </HBox>

        </VBox>

    </center>

    <bottom>

        <HBox alignment="CENTER_RIGHT">

            <padding>
                <Insets top="5.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #6F4E37;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>