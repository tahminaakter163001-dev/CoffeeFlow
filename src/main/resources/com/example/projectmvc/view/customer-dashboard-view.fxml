<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.CustomerDashboardController"
            minWidth="650.0"
            minHeight="500.0"
            prefWidth="900.0"
            prefHeight="600.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- ================= HEADER ================= -->

    <top>

        <VBox alignment="CENTER_LEFT"
              spacing="2.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="26.0"/>
                </font>

            </Label>

            <Label text="Customer Portal"
                   textFill="WHITE">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox alignment="CENTER"
              spacing="20.0">

            <padding>
                <Insets top="40.0"
                        right="40.0"
                        bottom="40.0"
                        left="40.0"/>
            </padding>


            <!-- Welcome -->

            <Label text="Welcome to CoffeeFlow"
                   style="-fx-text-fill: #4A3428;">

                <font>
                    <Font name="System Bold"
                          size="30.0"/>
                </font>

            </Label>


            <Label text="Customer Dashboard"
                   style="-fx-text-fill: #6F4E37;">

                <font>
                    <Font name="System Bold"
                          size="21.0"/>
                </font>

            </Label>


            <Label text="What would you like to do today?"
                   style="-fx-text-fill: #777777;">

                <font>
                    <Font size="15.0"/>
                </font>

            </Label>


            <!-- Space -->

            <Region prefHeight="10.0"/>


            <!-- ================= ACTION CARDS ================= -->

            <HBox alignment="CENTER"
                  spacing="25.0">

                <!-- New Order -->

                <VBox alignment="CENTER"
                      spacing="10.0"
                      prefWidth="230.0"
                      prefHeight="150.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #E0D3C5;
                             -fx-border-radius: 12;
                             -fx-border-width: 1;">

                    <Label text="☕"
                           style="-fx-text-fill: #6F4E37;">

                        <font>
                            <Font size="32.0"/>
                        </font>

                    </Label>

                    <Button text="New Order"
                            onAction="#openOrder"
                            prefWidth="170.0"
                            prefHeight="42.0"
                            style="-fx-background-color: #6F4E37;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>

                    <Label text="Create a new coffee order"
                           style="-fx-text-fill: #888888;"/>

                </VBox>


                <!-- My Orders -->

                <VBox alignment="CENTER"
                      spacing="10.0"
                      prefWidth="230.0"
                      prefHeight="150.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #E0D3C5;
                             -fx-border-radius: 12;
                             -fx-border-width: 1;">

                    <Label text="📋"
                           style="-fx-text-fill: #6F4E37;">

                        <font>
                            <Font size="32.0"/>
                        </font>

                    </Label>

                    <Button text="My Orders"
                            onAction="#openMyOrders"
                            prefWidth="170.0"
                            prefHeight="42.0"
                            style="-fx-background-color: #E8D8C8;
                                   -fx-text-fill: #4A3428;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>

                    <Label text="View your orders and payments"
                           style="-fx-text-fill: #888888;"/>

                </VBox>

            </HBox>


            <!-- Space -->

            <Region prefHeight="15.0"/>


            <!-- Logout -->

            <Button text="Logout"
                    onAction="#logout"
                    prefWidth="120.0"
                    prefHeight="38.0"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #B85450;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-text-fill: #B85450;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

        </VBox>

    </center>


    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER">

            <padding>
                <Insets top="12.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <Label text="CoffeeFlow • Enjoy your coffee experience"
                   style="-fx-text-fill: #999999;"/>

        </HBox>

    </bottom>

</BorderPane>