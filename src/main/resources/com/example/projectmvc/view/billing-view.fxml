<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.BillingController"
            minWidth="700.0"
            minHeight="550.0"
            prefWidth="950.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- Header -->
    <top>

        <VBox alignment="CENTER_LEFT"
              spacing="2.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="26.0"/>
                </font>

            </Label>

            <Label text="Billing &amp; Payment"
                   textFill="WHITE">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>

    </top>

    <!-- Main Content -->
    <center>

        <VBox spacing="18.0">

            <padding>
                <Insets top="25.0"
                        right="35.0"
                        bottom="20.0"
                        left="35.0"/>
            </padding>

            <!-- Title -->
            <VBox spacing="5.0">

                <Label text="Complete Your Payment"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="24.0"/>
                    </font>

                </Label>

                <Label text="Review your order and select a payment method."
                       style="-fx-text-fill: #777777;"/>

            </VBox>

            <!-- Order Summary -->
            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="18.0"
                            right="18.0"
                            bottom="18.0"
                            left="18.0"/>
                </padding>

                <Label text="Order Summary"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="18.0"/>
                    </font>

                </Label>

                <TableView fx:id="billingTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="250.0">

                    <columns>

                        <TableColumn fx:id="coffeeColumn"
                                     text="Coffee"
                                     prefWidth="200.0"/>

                        <TableColumn fx:id="sizeColumn"
                                     text="Size"
                                     prefWidth="110.0"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="110.0"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="130.0"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="130.0"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- Payment Area -->
            <HBox spacing="20.0"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="18.0"
                            right="20.0"
                            bottom="18.0"
                            left="20.0"/>
                </padding>

                <VBox spacing="5.0"
                      HBox.hgrow="ALWAYS">

                    <Label text="Payment Method"
                           style="-fx-text-fill: #6F4E37;">

                        <font>
                            <Font name="System Bold"
                                  size="15.0"/>
                        </font>

                    </Label>

                    <ComboBox fx:id="paymentMethodComboBox"
                              promptText="Select payment method"
                              prefHeight="40.0"
                              maxWidth="Infinity"/>

                </VBox>

                <VBox alignment="CENTER_RIGHT"
                      spacing="3.0">

                    <Label text="Total Amount"
                           style="-fx-text-fill: #777777;"/>

                    <Label fx:id="totalLabel"
                           text="Tk 0.00"
                           style="-fx-text-fill: #6F4E37;">

                        <font>
                            <Font name="System Bold"
                                  size="22.0"/>
                        </font>

                    </Label>

                </VBox>

            </HBox>

        </VBox>

    </center>

    <!-- Bottom Buttons -->
    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15.0">

            <padding>
                <Insets top="10.0"
                        right="35.0"
                        bottom="25.0"
                        left="35.0"/>
            </padding>

            <Button text="← Back"
                    onAction="#goBack"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #E8D8C8;
                           -fx-text-fill: #6F4E37;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button fx:id="confirmPaymentButton"
                    text="Confirm Payment ✓"
                    onAction="#handleConfirmPayment"
                    prefWidth="165.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #6F4E37;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>