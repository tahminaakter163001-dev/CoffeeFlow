<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            style="-fx-background-color: #F5EFE6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.RegisterController">

    <VBox alignment="CENTER"
          spacing="18.0"
          prefWidth="380.0"
          prefHeight="500.0"
          AnchorPane.leftAnchor="260.0"
          AnchorPane.rightAnchor="260.0"
          AnchorPane.topAnchor="50.0"
          AnchorPane.bottomAnchor="50.0"
          style="-fx-background-color: white;
                 -fx-background-radius: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 20, 0, 0, 5);">

        <padding>
            <Insets top="40" right="45" bottom="40" left="45"/>
        </padding>

        <Label text="CoffeeFlow ☕"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #6F4E37;"/>

        <Label text="Create Your Account"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #333333;"/>

        <Label text="Join CoffeeFlow and enjoy your favorite coffee."
               wrapText="true"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #777777;"/>

        <TextField fx:id="usernameField"
                   promptText="Username"
                   prefHeight="42.0"
                   style="-fx-background-radius: 10;
                          -fx-border-radius: 10;
                          -fx-border-color: #D6C2B3;
                          -fx-padding: 0 12;
                          -fx-font-size: 14px;"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="42.0"
                       style="-fx-background-radius: 10;
                              -fx-border-radius: 10;
                              -fx-border-color: #D6C2B3;
                              -fx-padding: 0 12;
                              -fx-font-size: 14px;"/>

        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm Password"
                       prefHeight="42.0"
                       style="-fx-background-radius: 10;
                              -fx-border-radius: 10;
                              -fx-border-color: #D6C2B3;
                              -fx-padding: 0 12;
                              -fx-font-size: 14px;"/>

        <Button fx:id="registerButton"
                text="Create Account"
                prefWidth="290.0"
                prefHeight="45.0"
                onAction="#handleRegister"
                style="-fx-background-color: #6F4E37;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-cursor: hand;"/>

        <Button text="Back to Login"
                prefWidth="290.0"
                prefHeight="40.0"
                onAction="#goBack"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #6F4E37;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #C0392B;"/>

    </VBox>

</AnchorPane>
