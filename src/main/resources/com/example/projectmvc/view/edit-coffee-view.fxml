<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="450.0" minWidth="400.0" prefHeight="550.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectmvc.controller.EditCoffeeController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Edit Coffee">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Label>

    <!-- Coffee Name -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label prefWidth="70.0" text="Name:" />

        <TextField fx:id="nameField" prefWidth="220.0" promptText="Coffee Name" />
    </HBox>

    <!-- Small -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label prefWidth="70.0" text="Small:" />

        <TextField fx:id="smallPriceField" maxWidth="220.0" prefHeight="25.0" prefWidth="220.0" promptText="Price (Tk)" />
    </HBox>

    <!-- Medium -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label prefWidth="70.0" text="Medium:" />

        <TextField fx:id="mediumPriceField" maxWidth="220.0" prefWidth="220.0" promptText="Price (Tk)" />
    </HBox>

    <!-- Large -->
    <HBox alignment="CENTER" spacing="10.0">
        <Label prefWidth="70.0" text="Large:" />

        <TextField fx:id="largePriceField" maxWidth="220.0" prefWidth="220.0" promptText="Price (Tk)" />
    </HBox>

    <HBox alignment="CENTER" spacing="40.0">

        <Button onAction="#handleUpdate" prefWidth="120.0" text="Update" />

        <Button onAction="#goBack" prefWidth="100.0" text="Back" />

    </HBox>

    <Label fx:id="messageLabel" wrapText="true" />

</VBox>
