<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.MyOrdersController"
            minWidth="750.0"
            minHeight="550.0"
            prefWidth="1100.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- Header -->
    <top>

        <VBox alignment="CENTER_LEFT"
              spacing="2.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="26.0"/>
                </font>

            </Label>

            <Label text="My Orders"
                   textFill="WHITE">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>

    </top>

    <!-- Main Content -->
    <center>

        <VBox spacing="15.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>
            </padding>

            <!-- Page Title -->
            <VBox spacing="5.0">

                <Label text="Your Orders"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="24.0"/>
                    </font>

                </Label>

                <Label text="View your order, payment and billing information."
                       wrapText="true"
                       style="-fx-text-fill: #777777;"/>

            </VBox>

            <!-- Orders Table -->
            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="15.0"
                            right="15.0"
                            bottom="15.0"
                            left="15.0"/>
                </padding>

                <TableView fx:id="ordersTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="350.0">

                    <columns>

                        <TableColumn fx:id="orderIdColumn"
                                     text="Order ID"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="billIdColumn"
                                     text="Bill ID"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="coffeeColumn"
                                     text="Coffee"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="sizeColumn"
                                     text="Size"
                                     prefWidth="90.0"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="90.0"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="orderDateColumn"
                                     text="Order Date"
                                     prefWidth="170.0"/>

                        <TableColumn fx:id="orderStatusColumn"
                                     text="Order Status"
                                     prefWidth="120.0"/>

                        <TableColumn fx:id="paymentMethodColumn"
                                     text="Payment Method"
                                     prefWidth="140.0"/>

                        <TableColumn fx:id="paymentStatusColumn"
                                     text="Payment Status"
                                     prefWidth="130.0"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

    <!-- Bottom -->
    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15.0">

            <padding>
                <Insets top="5.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <Button text="Cancel Selected Order"
                    onAction="#handleCancelOrder"
                    prefWidth="180.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #E8D8C8;
                           -fx-text-fill: #8B3A3A;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="← Back"
                    onAction="#goBack"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #6F4E37;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>