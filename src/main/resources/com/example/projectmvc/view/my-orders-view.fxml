<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.MyOrdersController"
            minWidth="900.0"
            minHeight="500.0"
            prefWidth="1200.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <padding>
        <Insets top="30.0"
                right="40.0"
                bottom="30.0"
                left="40.0"/>
    </padding>

    <top>
        <VBox spacing="8.0">

            <HBox alignment="CENTER_LEFT"
                  spacing="20.0">

                <Button text="← Back"
                        onAction="#goBack"
                        prefWidth="90.0"
                        prefHeight="38.0"
                        style="-fx-background-color: #6F4E37;
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-font-weight: bold;"/>

                <Label text="My Orders"
                       style="-fx-text-fill: #6F4E37;">
                    <font>
                        <Font name="System Bold"
                              size="28.0"/>
                    </font>
                </Label>

            </HBox>

            <Label text="View your order and payment information"
                   style="-fx-text-fill: #666666;"/>

        </VBox>
    </top>

    <center>
        <TableView fx:id="ordersTable">

            <columns>

                <TableColumn fx:id="orderIdColumn"
                             text="Order ID"
                             prefWidth="80.0"/>

                <TableColumn fx:id="billIdColumn"
                             text="Bill ID"
                             prefWidth="80.0"/>

                <TableColumn fx:id="coffeeColumn"
                             text="Coffee"
                             prefWidth="150.0"/>

                <TableColumn fx:id="sizeColumn"
                             text="Size"
                             prefWidth="90.0"/>

                <TableColumn fx:id="quantityColumn"
                             text="Quantity"
                             prefWidth="90.0"/>

                <TableColumn fx:id="priceColumn"
                             text="Price"
                             prefWidth="100.0"/>

                <TableColumn fx:id="totalColumn"
                             text="Total"
                             prefWidth="100.0"/>

                <TableColumn fx:id="orderDateColumn"
                             text="Order Date"
                             prefWidth="170.0"/>

                <TableColumn fx:id="orderStatusColumn"
                             text="Order Status"
                             prefWidth="120.0"/>

                <TableColumn fx:id="paymentMethodColumn"
                             text="Payment Method"
                             prefWidth="140.0"/>

                <TableColumn fx:id="paymentStatusColumn"
                             text="Payment Status"
                             prefWidth="120.0"/>

            </columns>

        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">

            <Label text="CoffeeFlow"
                   style="-fx-text-fill: #6F4E37;
                          -fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>