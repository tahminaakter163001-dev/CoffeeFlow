<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.geometry.Pos?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.LoginController"
            minWidth="900.0"
            minHeight="600.0"
            prefWidth="900.0"
            prefHeight="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #F5EFE6, #E8D8C8);">

    <children>

        <!-- Centered Login Section -->
        <VBox alignment="CENTER"
              spacing="18.0"
              prefWidth="410.0"
              prefHeight="520.0"
              maxWidth="410.0"
              maxHeight="520.0"
              AnchorPane.leftAnchor="245.0"
              AnchorPane.rightAnchor="245.0"
              AnchorPane.topAnchor="40.0"
              AnchorPane.bottomAnchor="40.0"
              style="-fx-background-color: #FFF9F3;
                     -fx-background-radius: 24;
                     -fx-effect: dropshadow(gaussian, rgba(60,40,25,0.20), 25, 0, 0, 7);">

            <padding>
                <Insets top="40.0"
                        right="55.0"
                        bottom="40.0"
                        left="55.0"/>
            </padding>

            <!-- Logo -->
            <Label text="CoffeeFlow ☕"
                   textFill="#6F4E37">

                <font>
                    <Font name="System Bold"
                          size="32.0"/>
                </font>

            </Label>

            <!-- Tagline -->
            <Label text="Where every cup tells a story."
                   textFill="#9A806C">

                <font>
                    <Font name="System Italic"
                          size="14.0"/>
                </font>

            </Label>

            <!-- Separator -->
            <Label text="────────────────"
                   textFill="#D6C2B3">

                <font>
                    <Font size="12.0"/>
                </font>

            </Label>

            <!-- Welcome Section -->
            <Label text="Welcome Back!"
                   textFill="#4A3428">

                <font>
                    <Font name="System Bold"
                          size="24.0"/>
                </font>

            </Label>

            <Label text="Sign in to your CoffeeFlow account"
                   textFill="#8C7A6B">

                <font>
                    <Font size="13.0"/>
                </font>

            </Label>

            <!-- Username -->
            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="290.0"
                       prefWidth="290.0"
                       prefHeight="44.0"
                       style="-fx-background-color: #FAF7F3;
                              -fx-background-radius: 12;
                              -fx-border-color: #D6C2B3;
                              -fx-border-width: 1.2;
                              -fx-border-radius: 12;
                              -fx-padding: 0 14;
                              -fx-font-size: 14px;
                              -fx-text-fill: #4A3428;
                              -fx-prompt-text-fill: #A89586;"/>

            <!-- Password -->
            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="290.0"
                           prefWidth="290.0"
                           prefHeight="44.0"
                           style="-fx-background-color: #FAF7F3;
                                  -fx-background-radius: 12;
                                  -fx-border-color: #D6C2B3;
                                  -fx-border-width: 1.2;
                                  -fx-border-radius: 12;
                                  -fx-padding: 0 14;
                                  -fx-font-size: 14px;
                                  -fx-text-fill: #4A3428;
                                  -fx-prompt-text-fill: #A89586;"/>

            <!-- Login Button -->
            <Button fx:id="loginButton"
                    text="Sign In  ☕"
                    mnemonicParsing="false"
                    onAction="#handleLogin"
                    maxWidth="290.0"
                    prefWidth="290.0"
                    prefHeight="48.0"
                    style="-fx-background-color: #6F4E37;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 14;
                           -fx-border-radius: 14;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(111,78,55,0.25), 8, 0, 0, 3);"/>

            <!-- Register Prompt -->
            <Label text="Don't have an account?"
                   textFill="#888888">

                <font>
                    <Font size="13.0"/>
                </font>

            </Label>

            <!-- Register Button -->
            <Button text="Create Account"
                    mnemonicParsing="false"
                    onAction="#openRegister"
                    maxWidth="290.0"
                    prefWidth="290.0"
                    prefHeight="42.0"
                    style="-fx-background-color: #F5EFE6;
                           -fx-text-fill: #6F4E37;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-border-color: #C8AD98;
                           -fx-border-width: 1.2;
                           -fx-border-radius: 12;
                           -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

        </VBox>

    </children>

</AnchorPane>
