<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.LoginController"
            minWidth="900.0"
            minHeight="600.0"
            prefWidth="1100.0"
            prefHeight="700.0"
            style="-fx-background-color: #F5EFE6;">

    <children>

        <HBox spacing="0.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- ================================================= -->
            <!-- LEFT COFFEE BRANDING SECTION -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       minWidth="380.0"
                       style="-fx-background-color: linear-gradient(to bottom right, #4A3022, #6F4E37, #8A6045);">

                <children>

                    <!-- Decorative Circle -->
                    <Circle radius="190.0"
                            fill="rgba(255,255,255,0.035)"
                            translateX="-170.0"
                            translateY="-250.0"/>

                    <Circle radius="140.0"
                            fill="rgba(255,255,255,0.025)"
                            translateX="250.0"
                            translateY="260.0"/>

                    <VBox alignment="CENTER"
                          spacing="18.0"
                          maxWidth="500.0"
                          maxHeight="600.0">

                        <padding>
                            <Insets top="40.0"
                                    right="55.0"
                                    bottom="40.0"
                                    left="55.0"/>
                        </padding>


                        <!-- Brand -->
                        <Label text="CoffeeFlow ☕"
                               textFill="WHITE"
                               textAlignment="CENTER">
                            <font>
                                <Font name="System Bold"
                                      size="42.0"/>
                            </font>
                        </Label>

                        <Label text="YOUR COFFEE, YOUR MOMENT."
                               textFill="#E8C9A8"
                               textAlignment="CENTER">
                            <font>
                                <Font name="System Bold"
                                      size="15.0"/>
                            </font>
                        </Label>

                        <!-- Divider -->
                        <Label text="────────────────────"
                               textFill="rgba(255,255,255,0.35)">
                            <font>
                                <Font size="12.0"/>
                            </font>
                        </Label>

                        <!-- Description -->
                        <Label text="A warm place for great coffee,&#10;good moments and meaningful connections."
                               textFill="#F4EDE6"
                               textAlignment="CENTER"
                               wrapText="true">
                            <font>
                                <Font size="16.0"/>
                            </font>
                        </Label>

                        <!-- Feature -->
                        <HBox alignment="CENTER"
                              spacing="12.0">

                            <Label text="☕ Freshly Brewed"
                                   textFill="#F4EDE6">
                                <font>
                                    <Font size="13.0"/>
                                </font>
                            </Label>

                            <Label text="•"
                                   textFill="#D9A06F"/>

                            <Label text="♥ Carefully Crafted"
                                   textFill="#F4EDE6">
                                <font>
                                    <Font size="13.0"/>
                                </font>
                            </Label>

                        </HBox>

                    </VBox>

                </children>

            </StackPane>


            <!-- ================================================= -->
            <!-- RIGHT LOGIN SECTION -->
            <!-- ================================================= -->

            <StackPane HBox.hgrow="ALWAYS"
                       minWidth="480.0"
                       style="-fx-background-color: #F7F3EE;">

                <children>

                    <!-- Login Card -->
                    <VBox alignment="CENTER"
                          spacing="16.0"
                          maxWidth="430.0"
                          maxHeight="590.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(60,40,25,0.16), 28, 0, 0, 8);">

                        <padding>
                            <Insets top="42.0"
                                    right="48.0"
                                    bottom="42.0"
                                    left="48.0"/>
                        </padding>

                        <!-- Small Welcome -->
                        <Label text="WELCOME BACK"
                               textFill="#B07A52">
                            <font>
                                <Font name="System Bold"
                                      size="12.0"/>
                            </font>
                        </Label>

                        <!-- Heading -->
                        <Label text="Sign In"
                               textFill="#3E2A20">
                            <font>
                                <Font name="System Bold"
                                      size="30.0"/>
                            </font>
                        </Label>

                        <!-- Description -->
                        <Label text="Sign in to continue to CoffeeFlow"
                               textFill="#8C7A6B"
                               wrapText="true">
                            <font>
                                <Font size="13.0"/>
                            </font>
                        </Label>


                        <!-- Username Label -->
                        <VBox spacing="6.0"
                              maxWidth="330.0">

                            <Label text="Username"
                                   textFill="#5B4030">
                                <font>
                                    <Font name="System Bold"
                                          size="12.0"/>
                                </font>
                            </Label>

                            <TextField fx:id="usernameField"
                                       promptText="Enter your username"
                                       maxWidth="330.0"
                                       prefHeight="46.0"
                                       style="-fx-background-color: #FAF8F5;
                                              -fx-background-radius: 12;
                                              -fx-border-color: #D8C8BA;
                                              -fx-border-width: 1.0;
                                              -fx-border-radius: 12;
                                              -fx-padding: 0 14;
                                              -fx-font-size: 14px;
                                              -fx-text-fill: #4A3428;
                                              -fx-prompt-text-fill: #A89586;"/>

                        </VBox>


                        <!-- Password Label -->
                        <VBox spacing="6.0"
                              maxWidth="330.0">

                            <Label text="Password"
                                   textFill="#5B4030">
                                <font>
                                    <Font name="System Bold"
                                          size="12.0"/>
                                </font>
                            </Label>

                            <PasswordField fx:id="passwordField"
                                           promptText="Enter your password"
                                           maxWidth="330.0"
                                           prefHeight="46.0"
                                           style="-fx-background-color: #FAF8F5;
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: #D8C8BA;
                                                  -fx-border-width: 1.0;
                                                  -fx-border-radius: 12;
                                                  -fx-padding: 0 14;
                                                  -fx-font-size: 14px;
                                                  -fx-text-fill: #4A3428;
                                                  -fx-prompt-text-fill: #A89586;"/>

                        </VBox>


                        <!-- Login Button -->
                        <Button fx:id="loginButton"
                                text="SIGN IN   ☕"
                                mnemonicParsing="false"
                                onAction="#handleLogin"
                                maxWidth="330.0"
                                prefHeight="50.0"
                                style="-fx-background-color: #6F4E37;
                                       -fx-text-fill: white;
                                       -fx-font-size: 15px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 14;
                                       -fx-border-radius: 14;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(111,78,55,0.28), 10, 0, 0, 4);"/>


                        <!-- Register Divider -->
                        <HBox alignment="CENTER"
                              spacing="8.0"
                              maxWidth="330.0">

                            <Label text="New to CoffeeFlow?"
                                   textFill="#8C7A6B">
                                <font>
                                    <Font size="12.0"/>
                                </font>
                            </Label>

                            <Button text="Create Account"
                                    mnemonicParsing="false"
                                    onAction="#openRegister"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #8A6045;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;
                                           -fx-padding: 2 0 2 0;"/>

                        </HBox>


                        <!-- Back Home -->
                        <Button text="←  Back to Home"
                                mnemonicParsing="false"
                                onAction="#handleBackToHome"
                                maxWidth="330.0"
                                prefHeight="36.0"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #9A806C;
                                       -fx-font-size: 12px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>

                    </VBox>

                </children>

            </StackPane>

        </HBox>

    </children>

</AnchorPane>