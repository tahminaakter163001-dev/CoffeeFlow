<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.projectmvc.controller.AddCoffeeController"
      alignment="CENTER"
      spacing="15.0"
      minWidth="400.0"
      minHeight="350.0"
      prefWidth="600.0"
      prefHeight="450.0">

    <padding>
        <Insets top="30.0"
                right="30.0"
                bottom="30.0"
                left="30.0"/>
    </padding>

    <Label text="Add New Coffee">
        <font>
            <Font name="System Bold" size="26.0"/>
        </font>
    </Label>

    <TextField fx:id="nameField"
               promptText="Coffee Name"
               maxWidth="300.0"/>

    <ComboBox fx:id="sizeComboBox"
              promptText="Select Size"
              maxWidth="300.0"/>

    <TextField fx:id="priceField"
               promptText="Price (Tk)"
               maxWidth="300.0"/>

    <HBox alignment="CENTER" spacing="15.0">

        <Button text="Add Coffee"
                onAction="#handleAddCoffee"
                prefWidth="130.0"/>

        <Button text="Back"
                onAction="#goBack"
                prefWidth="100.0"/>

    </HBox>

    <Label fx:id="messageLabel"
           wrapText="true"/>

</VBox>