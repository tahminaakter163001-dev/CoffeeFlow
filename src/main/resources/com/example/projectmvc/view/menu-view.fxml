<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.MenuController"
            minWidth="700.0"
            minHeight="450.0"
            prefWidth="900.0"
            prefHeight="600.0">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="25.0"
                        bottom="18.0"
                        left="25.0"/>
            </padding>

            <VBox spacing="5.0">
                <Label text="Coffee Menu"
                       textFill="WHITE">

                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>

                </Label>

                <Label text="Manage available coffee items"
                       textFill="WHITE"/>
            </VBox>

        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <!-- Search -->
            <HBox spacing="10.0"
                  alignment="CENTER_LEFT">

                <Label text="Search:"/>

                <TextField fx:id="searchField"
                           promptText="Search coffee..."
                           HBox.hgrow="ALWAYS"/>

            </HBox>

            <!-- Coffee Table -->
            <TableView fx:id="coffeeTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="70.0"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Coffee Name"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="smallPriceColumn"
                                 text="Small (Tk)"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="mediumPriceColumn"
                                 text="Medium (Tk)"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="largePriceColumn"
                                 text="Large (Tk)"
                                 prefWidth="130.0"/>

                </columns>

            </TableView>
            <!-- Buttons -->
            <HBox spacing="12.0"
                  alignment="CENTER_RIGHT">

                <Button text="＋ Add Coffee"
                        onAction="#openAddCoffee"
                        prefWidth="140.0"
                        prefHeight="35.0"/>

                <Button fx:id="editButton"
                        text="Edit"
                        prefWidth="100.0"
                        prefHeight="35.0"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        prefWidth="100.0"
                        prefHeight="35.0"/>

            </HBox>

        </VBox>
    </center>

    <!-- Bottom Back Button -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #F5E6D3;">

            <padding>
                <Insets top="12.0"
                        right="20.0"
                        bottom="12.0"
                        left="20.0"/>
            </padding>

            <Button text="← Back to Dashboard"
                    onAction="#goBack"
                    prefWidth="160.0"
                    prefHeight="35.0"/>

        </HBox>
    </bottom>

</BorderPane>