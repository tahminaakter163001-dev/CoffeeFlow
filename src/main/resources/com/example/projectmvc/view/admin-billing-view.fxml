<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.AdminBillingController"
            minWidth="750.0"
            minHeight="550.0"
            prefWidth="1100.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- Top Header -->
    <top>
        <VBox alignment="CENTER_LEFT"
              spacing="3.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="Billing Management"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="24.0"/>
                </font>

            </Label>

            <Label text="View customer payment and billing information."
                   textFill="WHITE"
                   wrapText="true">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>
    </top>

    <!-- Main Content -->
    <center>

        <VBox spacing="15.0">

            <padding>
                <Insets top="25.0"
                        right="30.0"
                        bottom="15.0"
                        left="30.0"/>
            </padding>

            <!-- Billing Table Card -->
            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="15.0"
                            right="15.0"
                            bottom="15.0"
                            left="15.0"/>
                </padding>

                <Label text="Customer Bills"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="18.0"/>
                    </font>

                </Label>

                <TableView fx:id="billingTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="400.0">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="Bill ID"
                                     prefWidth="80.0"/>

                        <TableColumn fx:id="customerColumn"
                                     text="Customer"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Total Amount"
                                     prefWidth="140.0"/>

                        <TableColumn fx:id="methodColumn"
                                     text="Payment Method"
                                     prefWidth="160.0"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Payment Status"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Payment Date"
                                     prefWidth="220.0"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

    <!-- Bottom -->
    <bottom>

        <HBox alignment="CENTER_RIGHT">

            <padding>
                <Insets top="5.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>

            <Button text="← Back"
                    onAction="#goBack"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #E8D8C8;
                           -fx-text-fill: #6F4E37;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>