<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.geometry.Pos?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.ComboBox?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.OrderController">

    <padding>
        <Insets top="30.0"
                right="40.0"
                bottom="30.0"
                left="40.0"/>
    </padding>

    <!-- TOP -->
    <top>
        <VBox spacing="8.0"
              alignment="CENTER">

            <Label text="Coffee Order">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>

            <Label text="Create a new coffee order"
                   style="-fx-text-fill: #666666;"/>
        </VBox>
    </top>


    <!-- CENTER -->
    <center>
        <VBox spacing="20.0">

            <!-- ORDER INPUT -->
            <VBox spacing="12.0">

                <Label text="Select Coffee">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>

                <ComboBox fx:id="coffeeComboBox"
                          promptText="Choose coffee"
                          prefHeight="38.0"
                          maxWidth="Infinity"/>


                <Label text="Select Size">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>

                <ComboBox fx:id="sizeComboBox"
                          promptText="Choose size"
                          prefHeight="38.0"
                          maxWidth="Infinity"/>


                <Label text="Quantity">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>

                <TextField fx:id="quantityField"
                           promptText="Enter quantity"
                           prefHeight="38.0"/>


                <Button fx:id="addToCartButton"
                        text="＋ Add to Cart"
                        onAction="#handleAddToCart"
                        prefWidth="150.0"
                        prefHeight="38.0"/>

            </VBox>


            <!-- CART -->
            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS">

                <Label text="Order Cart">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <TableView fx:id="cartTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="200.0">

                    <columns>

                        <TableColumn fx:id="coffeeColumn"
                                     text="Coffee"
                                     prefWidth="170.0"/>

                        <TableColumn fx:id="sizeColumn"
                                     text="Size"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="120.0"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="120.0"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>


    <!-- BOTTOM -->
    <bottom>
        <VBox spacing="15.0">

            <HBox alignment="CENTER_RIGHT">

                <Label text="Total: Tk ">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <Label fx:id="totalLabel"
                       text="0.00">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

            </HBox>


            <HBox spacing="12.0"
                  alignment="CENTER_RIGHT">

                <Button text="Back"
                        onAction="#goBack"
                        prefWidth="100.0"
                        prefHeight="38.0"/>

                <Button fx:id="placeOrderButton"
                        text="Place Order"
                        onAction="#handlePlaceOrder"
                        prefWidth="130.0"
                        prefHeight="38.0"/>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>