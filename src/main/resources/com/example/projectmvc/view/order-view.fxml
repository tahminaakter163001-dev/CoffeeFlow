<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.OrderController"
            minWidth="700.0"
            minHeight="550.0"
            prefWidth="950.0"
            prefHeight="650.0"
            style="-fx-background-color: #F5EFE6;">

    <!-- Header -->
    <top>

        <VBox alignment="CENTER_LEFT"
              spacing="2.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="26.0"/>
                </font>

            </Label>

            <Label text="New Order"
                   textFill="WHITE">

                <font>
                    <Font size="14.0"/>
                </font>

            </Label>

        </VBox>

    </top>

    <!-- Main Content -->
    <center>

        <VBox spacing="18.0">

            <padding>
                <Insets top="25.0"
                        right="35.0"
                        bottom="20.0"
                        left="35.0"/>
            </padding>

            <!-- Page Title -->
            <VBox spacing="5.0">

                <Label text="Create Your Order"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="24.0"/>
                    </font>

                </Label>

                <Label text="Choose your coffee, size and quantity."
                       style="-fx-text-fill: #777777;"/>

            </VBox>

            <!-- Selection Area -->
            <VBox spacing="12.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="20.0"
                            right="20.0"
                            bottom="20.0"
                            left="20.0"/>
                </padding>

                <Label text="Coffee Selection"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="17.0"/>
                    </font>

                </Label>

                <HBox spacing="15.0"
                      alignment="CENTER_LEFT">

                    <VBox spacing="6.0"
                          HBox.hgrow="ALWAYS">

                        <Label text="Coffee"/>

                        <ComboBox fx:id="coffeeComboBox"
                                  promptText="Choose coffee"
                                  prefHeight="38.0"
                                  maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="6.0"
                          HBox.hgrow="ALWAYS">

                        <Label text="Size"/>

                        <ComboBox fx:id="sizeComboBox"
                                  promptText="Choose size"
                                  prefHeight="38.0"
                                  maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="6.0"
                          HBox.hgrow="ALWAYS">

                        <Label text="Quantity"/>

                        <TextField fx:id="quantityField"
                                   promptText="Enter quantity"
                                   prefHeight="38.0"/>

                    </VBox>

                    <VBox alignment="BOTTOM_CENTER">

                        <Button fx:id="addToCartButton"
                                text="＋ Add to Cart"
                                onAction="#handleAddToCart"
                                prefWidth="140.0"
                                prefHeight="38.0"
                                style="-fx-background-color: #6F4E37;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- Cart -->
            <VBox spacing="10.0"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-radius: 12;
                         -fx-border-color: #E0D2C3;">

                <padding>
                    <Insets top="18.0"
                            right="18.0"
                            bottom="18.0"
                            left="18.0"/>
                </padding>

                <Label text="Order Cart"
                       style="-fx-text-fill: #6F4E37;">

                    <font>
                        <Font name="System Bold"
                              size="18.0"/>
                    </font>

                </Label>

                <TableView fx:id="cartTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="220.0">

                    <columns>

                        <TableColumn fx:id="coffeeColumn"
                                     text="Coffee"
                                     prefWidth="180.0"/>

                        <TableColumn fx:id="sizeColumn"
                                     text="Size"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="priceColumn"
                                     text="Price"
                                     prefWidth="120.0"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Total"
                                     prefWidth="120.0"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

    <!-- Bottom -->
    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="15.0">

            <padding>
                <Insets top="10.0"
                        right="35.0"
                        bottom="25.0"
                        left="35.0"/>
            </padding>

            <Label text="Total: Tk "
                   style="-fx-text-fill: #6F4E37;">

                <font>
                    <Font name="System Bold"
                          size="18.0"/>
                </font>

            </Label>

            <Label fx:id="totalLabel"
                   text="0.00"
                   style="-fx-text-fill: #6F4E37;">

                <font>
                    <Font name="System Bold"
                          size="18.0"/>
                </font>

            </Label>

            <Button text="← Back"
                    onAction="#goBack"
                    prefWidth="100.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #E8D8C8;
                           -fx-text-fill: #6F4E37;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button fx:id="placeOrderButton"
                    text="Place Order →"
                    onAction="#handlePlaceOrder"
                    prefWidth="140.0"
                    prefHeight="40.0"
                    style="-fx-background-color: #6F4E37;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </HBox>

    </bottom>

</BorderPane>