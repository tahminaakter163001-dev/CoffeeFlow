<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.DashboardController"
            minWidth="750.0"
            minHeight="500.0"
            prefWidth="1000.0"
            prefHeight="650.0">

    <!-- Top Header -->
    <top>
        <VBox alignment="CENTER_LEFT"
              spacing="2.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="25.0"
                        bottom="18.0"
                        left="25.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold"
                          size="26.0"/>
                </font>

            </Label>

            <Label text="Admin Dashboard"
                   textFill="WHITE">

                <font>
                    <Font size="16.0"/>
                </font>

            </Label>

        </VBox>
    </top>


    <!-- Left Navigation -->
    <left>
        <VBox spacing="12.0"
              prefWidth="180.0"
              style="-fx-background-color: #F5E6D3;">

            <padding>
                <Insets top="25.0"
                        right="15.0"
                        bottom="25.0"
                        left="15.0"/>
            </padding>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    prefHeight="40.0"/>

            <Button text="Coffee Menu"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    onAction="#openCoffeeMenu"/>

            <Button text="Logout"
                    onAction="#logout"
                    maxWidth="Infinity"
                    prefHeight="40.0"/>

        </VBox>
    </left>


    <!-- Main Content -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20.0">

            <padding>
                <Insets top="25.0"
                        right="25.0"
                        bottom="25.0"
                        left="25.0"/>
            </padding>


            <Label text="Admin Overview">

                <font>
                    <Font name="System Bold"
                          size="28.0"/>
                </font>

            </Label>


            <Label text="Monitor the overall coffee shop activity."
                   wrapText="true">

                <font>
                    <Font size="16.0"/>
                </font>

            </Label>


            <!-- Summary Cards -->
            <GridPane hgap="12.0"
                      vgap="12.0"
                      alignment="CENTER"
                      maxWidth="700.0">

                <!-- Total Orders -->
                <VBox GridPane.columnIndex="0"
                      GridPane.rowIndex="0"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #EFE2D5;
                 -fx-background-radius: 10;">

                    <Label text="Total Orders"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="totalOrdersCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>


                <!-- Pending -->
                <VBox GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #F3E4C8;
                 -fx-background-radius: 10;">

                    <Label text="Pending"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="pendingCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>


                <!-- Confirmed -->
                <VBox GridPane.columnIndex="2"
                      GridPane.rowIndex="0"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #DDE9DC;
                 -fx-background-radius: 10;">

                    <Label text="Confirmed"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="confirmedCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>


                <!-- Preparing -->
                <VBox GridPane.columnIndex="0"
                      GridPane.rowIndex="1"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #DCE7E8;
                 -fx-background-radius: 10;">

                    <Label text="Preparing"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="preparingCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>


                <!-- Ready -->
                <VBox GridPane.columnIndex="1"
                      GridPane.rowIndex="1"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #E1E8D9;
                 -fx-background-radius: 10;">

                    <Label text="Ready"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="readyCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>


                <!-- Cancelled -->
                <VBox GridPane.columnIndex="2"
                      GridPane.rowIndex="1"
                      alignment="CENTER"
                      spacing="5.0"
                      prefWidth="150.0"
                      prefHeight="90.0"
                      style="-fx-background-color: #EEDDDD;
                 -fx-background-radius: 10;">

                    <Label text="Cancelled"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="cancelledCount"
                           text="0"
                           style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>


            <!-- Total Sales -->
            <VBox alignment="CENTER"
                  spacing="5.0"
                  prefWidth="320.0"
                  prefHeight="95.0"
                  style="-fx-background-color: #DFF2E1;
                         -fx-background-radius: 10;">

                <Label text="Total Sales"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="totalSalesCount"
                       text="0.00 Tk"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>