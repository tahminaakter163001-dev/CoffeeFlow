<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projectmvc.controller.DashboardController"
            minWidth="600.0"
            minHeight="400.0"
            prefWidth="900.0"
            prefHeight="600.0">

    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              style="-fx-background-color: #6F4E37;">

            <padding>
                <Insets top="18.0"
                        right="25.0"
                        bottom="18.0"
                        left="25.0"/>
            </padding>

            <Label text="CoffeeFlow ☕"
                   textFill="WHITE">

                <font>
                    <Font name="System Bold" size="26.0"/>
                </font>

            </Label>

            <Label text="Coffee Shop Management System"
                   textFill="WHITE">

                <font>
                    <Font size="16.0"/>
                </font>

            </Label>

        </HBox>
    </top>

    <!-- Left Navigation -->
    <left>
        <VBox spacing="12.0"
              prefWidth="180.0"
              style="-fx-background-color: #F5E6D3;">

            <padding>
                <Insets top="25.0"
                        right="15.0"
                        bottom="25.0"
                        left="15.0"/>
            </padding>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    prefHeight="40.0"/>

            <Button text="Coffee Menu"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    onAction="#openCoffeeMenu"/>

            <Button text="Orders"
                    maxWidth="Infinity"
                    prefHeight="40.0"
                    onAction="#openOrders"/>

            <Button text="Billing"
                    maxWidth="Infinity"
                    prefHeight="40.0"/>

            <Button text="Logout"
                    onAction="#logout"
                    maxWidth="Infinity"
                    prefWidth="120.0"
                    prefHeight="40.0"/>

        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER"
              spacing="22.0">

            <padding>
                <Insets top="25.0"
                        right="25.0"
                        bottom="25.0"
                        left="25.0"/>
            </padding>

            <Label text="Welcome to CoffeeFlow">

                <font>
                    <Font name="System Bold"
                          size="30.0"/>
                </font>

            </Label>

            <Label text="Manage your coffee shop easily and efficiently."
                   wrapText="true">

                <font>
                    <Font size="17.0"/>
                </font>

            </Label>

            <!-- Order Summary -->
            <Label text="Order Status Summary">

                <font>
                    <Font name="System Bold"
                          size="20.0"/>
                </font>

            </Label>

            <HBox alignment="CENTER"
                  spacing="10.0">

                <VBox alignment="CENTER"
                      spacing="5.0"
                      prefWidth="105.0"
                      prefHeight="75.0"
                      style="-fx-background-color: #FFF3CD;">

                    <Label text="Pending"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="pendingCount"
                           text="0"
                           style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="5.0"
                      prefWidth="105.0"
                      prefHeight="75.0"
                      style="-fx-background-color: #DCEBFF;">

                    <Label text="Preparing"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="preparingCount"
                           text="0"
                           style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="5.0"
                      prefWidth="105.0"
                      prefHeight="75.0"
                      style="-fx-background-color: #E8DDF5;">

                    <Label text="Ready"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="readyCount"
                           text="0"
                           style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="5.0"
                      prefWidth="105.0"
                      prefHeight="75.0"
                      style="-fx-background-color: #DFF2E1;">

                    <Label text="Completed"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="completedCount"
                           text="0"
                           style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                </VBox>

                <VBox alignment="CENTER"
                      spacing="5.0"
                      prefWidth="105.0"
                      prefHeight="75.0"
                      style="-fx-background-color: #F8D7DA;">

                    <Label text="Cancelled"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="cancelledCount"
                           text="0"
                           style="-fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>